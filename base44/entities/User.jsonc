{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "URL p\u00fablica de la foto de perfil del usuario"
    },
    "demo_dismissed": {
      "type": "boolean",
      "default": false
    },
    "demo_seeded": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se crearon las partituras de ejemplo iniciales para esta cuenta"
    },
    "demo_sets_seeded": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se crearon los repertorios de ejemplo iniciales para esta cuenta"
    },
    "demo_bands_seeded": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se crearon las bandas de ejemplo iniciales para esta cuenta"
    },
    "demo_linked": {
      "type": "boolean",
      "default": false,
      "description": "Indica si los repertorios demo ya fueron asociados a las bandas demo"
    },
    "onboarding_done": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el usuario complet\u00f3 el onboarding inicial"
    },
    "settings": {
      "type": "string"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}