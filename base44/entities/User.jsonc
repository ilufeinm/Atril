{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "URL p\u00fablica de la foto de perfil del usuario"
    },
    "demo_dismissed": {
      "type": "boolean",
      "default": false
    },
    "demo_seeded": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se crearon las partituras de ejemplo iniciales para esta cuenta"
    },
    "demo_sets_seeded": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se crearon los repertorios de ejemplo iniciales para esta cuenta"
    },
    "demo_bands_seeded": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se crearon las bandas de ejemplo iniciales para esta cuenta"
    },
    "demo_linked": {
      "type": "boolean",
      "default": false,
      "description": "Indica si los repertorios demo ya fueron asociados a las bandas demo"
    },
    "onboarding_done": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el usuario complet\u00f3 el onboarding inicial"
    },
    "settings": {
      "type": "string"
    },
    "premium_until": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de vencimiento del Premium otorgado por referidos (independiente de la suscripci\u00f3n de Stripe)"
    },
    "referral_count": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de m\u00fasicos distintos que se unieron a las bandas creadas por este usuario"
    },
    "referral_premium_granted": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de meses de Premium ya otorgados por referidos"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}