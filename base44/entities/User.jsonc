{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "demo_dismissed": {
      "type": "boolean",
      "default": false
    },
    "demo_seeded": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se crearon las partituras de ejemplo iniciales para esta cuenta"
    },
    "demo_sets_seeded": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se crearon los repertorios de ejemplo iniciales para esta cuenta"
    },
    "demo_bands_seeded": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se crearon las bandas de ejemplo iniciales para esta cuenta"
    },
    "settings": {
      "type": "string"
    }
  },
  "required": [
