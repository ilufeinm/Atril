{
  "name": "Song",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "composer": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "meter": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "folder": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    },
    "favorite": {
      "type": "boolean",
      "default": false
    },
    "file_url": {
      "type": "string"
    },
    "page_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "page_order": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "content": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "structure": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "duration": {
      "type": "number"
    },
    "pages": {
      "type": "number"
    },
    "annotations": {
      "type": "string"
    },
    "last_page": {
      "type": "number",
      "default": 1
    },
    "font_scale": {
      "type": "number",
      "default": 1
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}