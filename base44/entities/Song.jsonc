{
  "name": "Song",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "meter": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "folder": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    },
    "favorite": {
      "type": "boolean",
      "default": false
    },
    "file_url": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "structure": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "duration": {
      "type": "number"
    },
    "pages": {
      "type": "number"
    },
    "annotations": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}