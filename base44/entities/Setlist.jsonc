{
  "name": "Setlist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "band_id": {
      "type": "string"
    },
    "song_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "editor_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.editor_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}